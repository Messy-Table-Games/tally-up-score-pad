{
  "name": "tallyup-scorepad",
  "version": "1.0.0",
  "description": "A score keeping app for the dice game Tally Up!",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "dev": "webpack serve --open --config webpack/webpack.dev.js",
    "dev:poll": "webpack serve --open --watch-options-poll --config webpack/webpack.dev.js",
    "build": "webpack --config webpack/webpack.prod.js",
    "build:staging": "webpack --config webpack/webpack.staging.js",
    "storybook": "storybook dev -p 6006",
    "tests": "node tests/model_tests.js && node tests/locale_tests.js"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "mobx": "^6.16.0"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "^10.4.2",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^17.4.2",
    "html-webpack-plugin": "^5.6.7",
    "storybook": "^10.4.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1",
    "workbox-background-sync": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1"
  }
}
