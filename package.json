{
  "name": "tallyup-scorepad",
  "version": "1.0.0",
  "description": "A score keeping app for the dice game Tally Up!",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "dev": "webpack serve --open --config webpack/webpack.dev.js",
    "dev:poll": "webpack serve --open --watch-options-poll --config webpack/webpack.dev.js",
    "build": "webpack --config webpack/webpack.prod.js",
    "deploy": "firebase deploy",
    "storybook": "storybook dev -p 6006",
    "tests": "node tests/model_tests.js"
  },
  "dependencies": {
    "lit": "^3.3.0",
    "mobx": "^6.13.7"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "^9.0.15",
    "copy-webpack-plugin": "^13.0.1",
    "firebase-tools": "^14.9.0",
    "html-webpack-plugin": "^5.6.3",
    "minify-html-literals-loader": "^1.1.1",
    "storybook": "^9.0.15",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1",
    "workbox-background-sync": "^7.4.0",
    "workbox-webpack-plugin": "^7.3.0"
  }
}
